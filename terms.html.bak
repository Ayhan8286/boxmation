<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/><style>

        :root {
            --ts-pink: #f386a1;
            --ts-green: #03aa5c;
            --ts-magenta: #d45bb6;
            --ts-teal: #09aea1;
            --ts-dark: #1e1e1e;
            --ts-white: #fefefe;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--ts-white);
            color: var(--ts-dark);
            overflow-x: hidden;
            /* Subtle grid background */
            background-image: linear-gradient(var(--ts-dark) 1px, transparent 1px),
            linear-gradient(90deg, var(--ts-dark) 1px, transparent 1px);
            background-size: 50px 50px;
            background-position: -1px -1px;
            background-attachment: fixed;
        }
        /* Put a white background on sections so grid is only visible in gaps or specific areas */
        section, header, footer, .bg-white {
            background-color: var(--ts-white);
        }
        .font-display {
            font-family: 'JetBrains Mono', monospace;
            letter-spacing: -0.04em;
        }
        .mono {
            font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
        }
        ::selection {
            background-color: var(--ts-dark);
            color: var(--ts-white);
        }
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--ts-white);
            border-left: 1px solid var(--ts-dark);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--ts-dark);
            border-radius: 0px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--ts-green);
        }
        .brutalist-border {
            border: 1px solid var(--ts-dark);
        }
        /* Neo-brutalist hover effect */
        .brutalist-button {
            transition: all 0.2s cubic-bezier(0.25, 1, 0.5, 1);
            box-shadow: 2px 2px 0px 0px var(--ts-dark);
        }
        .brutalist-button:hover {
            transform: translate(-2px, -2px);
            box-shadow: 4px 4px 0px 0px var(--ts-dark);
        }
        .brutalist-button:active {
            transform: translate(2px, 2px);
            box-shadow: 0px 0px 0px 0px var(--ts-dark);
        }
        /* Marquee Animation */
        @keyframes marquee {
            0% { transform: translateX(0%); }
            100% { transform: translateX(-100%); }
        }
        .marquee-container {
            overflow: hidden;
            white-space: nowrap;
            border-bottom: 1px solid var(--ts-dark);
            border-top: 1px solid var(--ts-dark);
            background-color: var(--ts-green);
            color: var(--ts-white);
            padding: 8px 0;
            display: flex;
        }
        .marquee-content {
            display: inline-block;
            animation: marquee 20s linear infinite;
            padding-right: 20px;
        }
        /* Typing cursor */
        .cursor-blink::after {
            content: "█";
            animation: blink 1s step-start infinite;
            color: var(--ts-magenta);
            margin-left: 4px;
        }
        @keyframes blink { 50% { opacity: 0; } }
        /* Reveal animation */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        .bento-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 0;
            border-top: 1px solid var(--ts-dark);
            border-left: 1px solid var(--ts-dark);
            background-color: var(--ts-white);
        }
        .bento-grid > div {
            border-right: 1px solid var(--ts-dark);
            border-bottom: 1px solid var(--ts-dark);
            background-color: var(--ts-white);
            transition: background-color 0.3s;
        }
        .bento-grid > div:hover {
            background-color: #fafafa;
        }

