<a class="inline-flex items-center justify-center px-3 py-2 sm:px-5 sm:py-2.5 bg-primary-container text-on-primary-container font-body-sm text-body-sm font-semibold hover:bg-secondary-container hover:text-on-secondary-container transition-all whitespace-nowrap brutalist-border brutalist-button" href="/booking.html"><span class="hidden sm:inline">Book Fit Call / Discovery</span><span class="inline sm:hidden">Book Call</span></a>
<button aria-label="Toggle menu" class="xl:hidden p-1 text-on-surface hover:bg-surface-container-high transition-colors flex items-center justify-center brutalist-border brutalist-button" id="mobile-menu-btn">
<span class="material-symbols-outlined">menu</span>
</button>
</div>
